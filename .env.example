# FM1 Open build environment (template).
# Copy to `.env` and adjust the paths for your machine. Never commit `.env`.

# Required for every build (HTTPS URL of this build's source archive):
FM1_SOURCE_URL=https://github.com/m-vave/fm1_open

# Required for firmware builds; the folder must contain bin/clang.exe:
FM1_PI32_TOOLCHAIN=C:\JL\pi32-2.5.2\C$\JL\pi32

# Optional: reuse an extracted WASI SDK 27 instead of downloading it:
FM1_WASI_SDK=C:\wasi-sdk-27
